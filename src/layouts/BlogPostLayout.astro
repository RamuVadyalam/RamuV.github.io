---
import BaseLayout from './BaseLayout.astro';
import TagPill from '~/components/TagPill.astro';
import { formatDate, isoDate } from '~/lib/posts';
import { withBase } from '~/lib/url';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags: string[];
  readingMinutes?: number;
}

const { title, description, pubDate, updatedDate, tags, readingMinutes } = Astro.props;
---
<BaseLayout
  title={title}
  description={description}
  ogType="article"
  publishedTime={pubDate.toISOString()}
  tags={tags}
>
  <article>
    <header class="mb-8 border-b border-[var(--color-border)] pb-6">
      <div class="mb-3 flex flex-wrap items-center gap-3 font-mono text-xs text-[var(--color-muted)]">
        <time datetime={isoDate(pubDate)}>{formatDate(pubDate)}</time>
        {readingMinutes && <span>· {readingMinutes} min read</span>}
        {updatedDate && (
          <span>· updated {formatDate(updatedDate)}</span>
        )}
      </div>
      <h1 class="text-3xl font-bold leading-tight sm:text-4xl">{title}</h1>
      <p class="mt-3 text-lg text-[var(--color-muted)]">{description}</p>
      {tags.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-2">
          {tags.map((t) => <TagPill tag={t} />)}
        </div>
      )}
    </header>
    <div class="prose prose-engineering">
      <slot />
    </div>
    <footer class="mt-12 border-t border-[var(--color-border)] pt-6 text-sm text-[var(--color-muted)]">
      <a href={withBase('/blog')} class="no-underline hover:underline">← Back to all posts</a>
    </footer>
  </article>
</BaseLayout>
