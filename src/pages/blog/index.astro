---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PostCard from '~/components/PostCard.astro';
import TagPill from '~/components/TagPill.astro';
import { getPublishedPosts, getAllTags } from '~/lib/posts';

const posts = await getPublishedPosts();
const tags = [...(await getAllTags()).entries()].sort((a, b) => b[1] - a[1]);
---
<BaseLayout title="Blog" description="Architecture and systems-thinking essays on the modern data stack.">
  <header class="mb-8">
    <h1 class="text-3xl font-bold sm:text-4xl">Blog</h1>
    <p class="mt-3 text-lg text-[var(--color-muted)]">
      {posts.length} posts on lakehouse architectures, streaming, observability,
      orchestration, cost, and where the data ecosystem is heading.
    </p>
    <div class="mt-4">
      <input
        id="post-search"
        type="search"
        placeholder="Filter posts (title, description, tag)…"
        class="w-full rounded-md border border-[var(--color-border)] bg-[var(--color-card)] px-3 py-2 text-sm text-[var(--color-fg)] placeholder:text-[var(--color-muted)] focus:border-[var(--color-accent)] focus:outline-none"
        aria-label="Filter posts"
      />
    </div>
  </header>

  {tags.length > 0 && (
    <section class="mb-10">
      <div class="mb-2 text-sm font-medium">Topics</div>
      <div class="flex flex-wrap gap-2">
        {tags.map(([t, c]) => <TagPill tag={t} count={c} />)}
      </div>
    </section>
  )}

  <section id="post-list" class="">
    {posts.map((post) => (
      <div
        class="post-row"
        data-title={post.data.title.toLowerCase()}
        data-desc={post.data.description.toLowerCase()}
        data-tags={post.data.tags.join(' ').toLowerCase()}
      >
        <PostCard post={post} />
      </div>
    ))}
    <p id="post-empty" class="hidden py-8 text-center text-[var(--color-muted)]">
      No posts match that filter.
    </p>
  </section>

  <script is:inline>
    (function () {
      const input = document.getElementById('post-search');
      const list = document.getElementById('post-list');
      const empty = document.getElementById('post-empty');
      if (!input || !list) return;
      const rows = Array.from(list.querySelectorAll('.post-row'));
      input.addEventListener('input', (e) => {
        const q = e.target.value.trim().toLowerCase();
        let shown = 0;
        for (const row of rows) {
          const hay =
            (row.dataset.title || '') + ' ' +
            (row.dataset.desc || '') + ' ' +
            (row.dataset.tags || '');
          const match = !q || hay.includes(q);
          row.style.display = match ? '' : 'none';
          if (match) shown++;
        }
        if (empty) empty.classList.toggle('hidden', shown !== 0);
      });
    })();
  </script>
</BaseLayout>
