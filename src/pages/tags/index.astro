---
import BaseLayout from '~/layouts/BaseLayout.astro';
import TagPill from '~/components/TagPill.astro';
import { getAllTags } from '~/lib/posts';

const tags = [...(await getAllTags()).entries()].sort((a, b) => {
  if (b[1] !== a[1]) return b[1] - a[1];
  return a[0].localeCompare(b[0]);
});
---
<BaseLayout title="Tags" description="Browse posts by topic.">
  <h1 class="text-3xl font-bold sm:text-4xl">Tags</h1>
  <p class="mt-3 text-lg text-[var(--color-muted)]">
    Browse posts by topic. {tags.length} tags across the blog.
  </p>
  <div class="mt-8 flex flex-wrap gap-2">
    {tags.map(([tag, count]) => <TagPill tag={tag} count={count} />)}
  </div>
</BaseLayout>
