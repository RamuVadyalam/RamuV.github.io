---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PostCard from '~/components/PostCard.astro';
import { getPublishedPosts, tagSlug } from '~/lib/posts';
import { withBase } from '~/lib/url';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tagMap = new Map<string, typeof posts>();
  for (const post of posts) {
    for (const tag of post.data.tags) {
      const key = tagSlug(tag);
      const list = tagMap.get(key) ?? [];
      list.push(post);
      tagMap.set(key, list);
    }
  }
  return [...tagMap.entries()].map(([slug, postsForTag]) => ({
    params: { tag: slug },
    props: {
      tag: postsForTag[0].data.tags.find((t) => tagSlug(t) === slug) ?? slug,
      posts: postsForTag,
    },
  }));
}

const { tag, posts } = Astro.props;
---
<BaseLayout title={`#${tag}`} description={`Posts tagged "${tag}".`}>
  <header class="mb-8">
    <p class="font-mono text-xs uppercase tracking-widest text-[var(--color-muted)]">tag</p>
    <h1 class="mt-2 text-3xl font-bold sm:text-4xl">#{tag}</h1>
    <p class="mt-3 text-[var(--color-muted)]">
      {posts.length} post{posts.length === 1 ? '' : 's'}.
      <a href={withBase('/tags')} class="ml-1">All tags →</a>
    </p>
  </header>
  <section>
    {posts.map((post) => <PostCard post={post} />)}
  </section>
</BaseLayout>
